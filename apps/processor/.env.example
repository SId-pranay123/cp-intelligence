# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=cp_password

# AI provider — "groq" | "gemini" | "claude"
AI_PROVIDER=groq

# Provider-specific keys (only the key for the chosen provider is required)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=your_anthropic_api_key

# PostgreSQL (same DB as the NestJS API)
POSTGRES_URL=postgresql://cp_user:cp_password@localhost:5432/cp_intelligence

# gRPC
GRPC_PORT=50051
