# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=cp_password

# AI provider — "claude" | "openai" | "gemini"
AI_PROVIDER=claude

# Provider-specific keys (only the key for the chosen provider is required)
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key

# PostgreSQL (same DB as the NestJS API)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/cp_intelligence

# gRPC
GRPC_PORT=50051
