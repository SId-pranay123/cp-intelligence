# PostgreSQL
DATABASE_URL=postgresql://cp_user:cp_password@localhost:5432/cp_intelligence

# Redis
REDIS_URL=redis://localhost:6379

# Neo4j (used by Go processor, kept here for reference)
NEO4J_URI=bolt://localhost:7687

# Codeforces
CODEFORCES_API_KEY=your_codeforces_api_key

# AI provider — the Go processor owns AI calls, but the NestJS API
# may pass an API key through if needed in future flows
ANTHROPIC_API_KEY=your_anthropic_api_key

# Auth
JWT_SECRET=change_me_in_production

# Go gRPC service
GO_SERVICE_URL=localhost:50051

# App
PORT=3001
NODE_ENV=development
