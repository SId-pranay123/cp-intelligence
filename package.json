{
  "name": "cp-intelligence",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "npm -w apps/api run start:dev",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "dev:processor": "cd apps/processor && go run ./cmd/processor"
  }
}
